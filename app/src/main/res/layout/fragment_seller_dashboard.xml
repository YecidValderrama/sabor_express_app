<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Encabezado: Pase de Cocina y badge de En vivo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvKitchenPassTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pase de Cocina"
            android:textColor="@color/terracota_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_biometric_button"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="• En vivo - Activas"
            android:textColor="@color/terracota_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tvKitchenPassTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvKitchenPassTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- HorizontalScrollView con ChipGroup para filtrar estados -->
    <HorizontalScrollView
        android:id="@+id/hsvOrderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/layoutDashboardHeader">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPending"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Pendientes (4)"
                app:chipBackgroundColor="@color/nav_item_color"
                app:chipCornerRadius="14dp"
                app:chipStrokeColor="@color/terracota_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInPrep"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En Preparación (2)"
                app:chipCornerRadius="14dp"
                app:chipStrokeColor="@color/border_light" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReady"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listas (6)"
                app:chipCornerRadius="14dp"
                app:chipStrokeColor="@color/border_light" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- RecyclerView para listar las comandas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSellerOrders"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hsvOrderStatus"
        tools:listitem="@layout/item_seller_order" />

</androidx.constraintlayout.widget.ConstraintLayout>

