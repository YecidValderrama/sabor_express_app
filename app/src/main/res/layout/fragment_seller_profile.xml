<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Avatar circular del vendedor con cámara -->
        <FrameLayout
            android:id="@+id/flSellerPhotoContainer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSellerAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="#EFEAE4"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_person"
                android:contentDescription="Foto de perfil del vendedor"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SaborExpress.Large"
                app:strokeColor="@color/terracota_primary"
                app:strokeWidth="2dp"
                app:tint="@color/terracota_primary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnChangeSellerPhoto"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/terracota_primary"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="Actualizar foto del vendedor"
                    app:tint="@color/text_white" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Tarjeta con Datos Personales y Rol -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSellerData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/surface_white"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/flSellerPhotoContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Badge de Rol y Sede -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_biometric_button"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="Rol: Vendedor / Cocina"
                        android:textColor="@color/terracota_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Sede Parque 93"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Nombres -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSellerName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombres completos"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/terracota_primary"
                    app:hintTextColor="@color/terracota_primary"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/terracota_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSellerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:text="Carlos Andrés Mendoza"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Correo con badge verificado -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSellerEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Correo corporativo"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/terracota_primary"
                    app:hintTextColor="@color/terracota_primary"
                    app:startIconDrawable="@drawable/ic_email_outline"
                    app:startIconTint="@color/terracota_primary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_check_circle"
                    app:endIconTint="#2E7D32"
                    app:helperText="Verificado"
                    app:helperTextTextColor="#2E7D32">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSellerEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:text="carlos.mendoza@saborexpress.com"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Teléfono -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSellerPhone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Teléfono de contacto"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/terracota_primary"
                    app:hintTextColor="@color/terracota_primary"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/terracota_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSellerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:text="+57 320 123 4567"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón terracota: Guardar Cambios -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSellerProfile"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/terracota_primary"
            android:text="Guardar Cambios"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardSellerData" />

        <!-- Botón rojo: "Cerrar Sesión" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogoutSeller"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Cerrar Sesión"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="#D32F2F"
            app:strokeColor="#D32F2F"
            app:strokeWidth="1.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSaveSellerProfile" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

