<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos para autenticación biométrica -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Compatibilidad con API < 28 -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Conectividad a internet requerida por la app -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaborExpress">

        <!-- Actividad Splash (Punto de entrada de la aplicación) -->
        <activity
            android:name=".common.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Login -->
        <activity
            android:name=".common.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de Recuperación de Contraseña -->
        <activity
            android:name=".common.RecoveryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla Principal del Rol Comprador -->
        <activity
            android:name=".buyer.BuyerMainActivity"
            android:exported="false" />

        <!-- Pantalla Principal del Rol Vendedor -->
        <activity
            android:name=".seller.SellerMainActivity"
            android:exported="false" />

        <!-- Pantalla Principal del Rol Administrador -->
        <activity
            android:name=".admin.AdminMainActivity"
            android:exported="false" />

    </application>

</manifest>

